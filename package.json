{
  "name": "pi-genui",
  "version": "0.1.0",
  "description": "Generative UI for Pi: charts, tables, diagrams and interactive controls rendered inline in the terminal",
  "type": "module",
  "license": "MIT",
  "author": "Christopher",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chrischriscris/pi-genui.git"
  },
  "homepage": "https://github.com/chrischriscris/pi-genui#readme",
  "bugs": "https://github.com/chrischriscris/pi-genui/issues",
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "pi-package",
    "pi-extension",
    "generative-ui",
    "tui",
    "terminal",
    "charts"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run typecheck && bun test"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@earendil-works/pi-tui": "1.4.0",
    "@types/bun": "^1.4.4",
    "typebox": "1.3.27",
    "typescript": "^7.0.2"
  }
}
